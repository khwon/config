[core]
  excludesfile = ~/.gitignore_global
  editor = vim
  autocrlf = input
[color]
  ui = auto
[init]
  defaultBranch = main
[pull]
  rebase = true
[push]
  default = simple
[fetch]
  prune = true
[merge]
  renamelimit = 2048
[diff]
  algorithm = histogram
[rerere]
  enabled = true
[include]
  path = ~/.gitconfig_local
